{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            {# Lien de retour #}
            <div class="mb-4">
                <a href="{#{{ path('account_index') }}#}" class="text-dark text-decoration-none small fw-semibold">
                    ← Retour à mon profil
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">

                {# En-tête #}
                <div class="text-center mb-4 pb-2 border-bottom">
                    <h1 class="h3 fw-bold text-dark mb-2">Modifier mon mot de passe</h1>
                    <p class="text-dark small mb-3">Pour garantir la sécurité de votre compte, choisissez un mot de passe robuste.</p>
                </div>

                {# Formulaire de mise à jour #}
                {{ form_start(myForm, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="d-flex flex-column gap-3 mb-4">
                        {{ form_widget(myForm) }}
                    </div>

                    {# Encadré de consignes de sécurité #}
                    <div class="bg-light border rounded-3 p-3 mb-4">
                        <p class="small fw-bold text-dark mb-2">Recommandations de sécurité :</p>
                        <ul class="small text-dark mb-0 ps-3">
                            <li>Au moins 8 caractères</li>
                            <li>Une combinaison de lettres majuscules et minuscules</li>
                            <li>Au moins un chiffre et un caractère spécial</li>
                        </ul>
                    </div>

                    {# Actions #}
                    <div class="d-flex flex-column flex-sm-row justify-content-end align-items-center gap-2 pt-3 border-top">
                        <a href="{#{{ path('account_index') }}#}" class="btn btn-outline-dark rounded-pill px-4 py-2 w-100 w-sm-auto order-2 order-sm-1">
                            Annuler
                        </a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm w-100 w-sm-auto order-1 order-sm-2">
                            Confirmer la modification
                        </button>
                    </div>

                {{ form_end(myForm) }}

            </div>

        </div>
    </div>
</div>
{% endblock %}