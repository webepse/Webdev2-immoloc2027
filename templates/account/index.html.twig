{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                
                <div class="text-center mb-4">
                    <h1 class="h3 fw-bold text-dark mb-2">Connexion</h1>
                    <p class="text-dark small mb-0">Accédez à votre espace pour gérer vos annonces et réservations.</p>
                </div>

                {# Gestion des erreurs d'authentification #}
                {% if hasError %}
                    <div class="alert alert-danger rounded-3 py-2 px-3 small mb-4" role="alert">
                        Une erreur est survenue, le nom d'utilisateur ou le mot de passe est invalide.
                    </div>
                {% endif %}
               
                {% if loginError %}
                    <div class="alert alert-danger rounded-3 py-2 px-3 small mb-4" role="alert">
                        {{ loginError }}
                    </div>
                {% endif %}
           
                <form action="{{ path('account_login') }}" method="POST">
                    
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold text-dark small">Adresse email</label>
                        <input type="email" 
                               name="_username" 
                               id="email" 
                               class="form-control rounded-3 py-2" 
                               placeholder="nom@exemple.com" 
                               required 
                               value="{{ username }}"
                               autocomplete="email">
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="password" class="form-label fw-semibold text-dark small mb-0">Mot de passe</label>
                            <a href="#" class="text-primary text-decoration-none small">Mot de passe oublié ?</a>
                        </div>
                        <input type="password" 
                               name="_password" 
                               id="password" 
                               class="form-control rounded-3 py-2" 
                               placeholder="Votre mot de passe" 
                               required
                               autocomplete="current-password">
                    </div>

                    {# Protection CSRF native si activée dans security.yaml #}
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 fw-semibold shadow-sm py-2">
                        Se connecter
                    </button>

                </form>

                <div class="text-center border-top pt-4 mt-4">
                    <p class="text-dark small mb-0">
                        Pas encore inscrit ? 
                        <a href="#" class="text-primary text-decoration-none fw-semibold">
                            Créer un compte
                        </a>
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>
{% endblock %}