{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                
                <div class="text-center mb-4">
                    <h1 class="h3 fw-bold text-dark mb-2">Inscription sur ImmoLoc</h1>
                    <p class="text-muted small">Créez votre profil en quelques instants pour louer ou réserver un logement.</p>
                </div>

                {{ form_start(myForm, {'attr': {'novalidate': 'novalidate'}}) }}
                    
                    {# Rendu des champs du formulaire #}
                    <div class="d-flex flex-column gap-3 mb-4">
                        {{ form_widget(myForm) }}
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 fw-semibold shadow-sm py-2">
                        Confirmer l'inscription
                    </button>

                {{ form_end(myForm) }}

                <div class="text-center border-top pt-4 mt-4">
                    <p class="text-muted small mb-0">
                        Vous avez déjà un compte ? 
                        <a href="{{ path('account_login') }}" class="text-primary text-decoration-none fw-semibold">
                            Connectez-vous
                        </a>
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>
{% endblock %}